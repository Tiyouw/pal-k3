# Contoh rahasia harness QA. SALIN, jangan diisi di tempat ini.
#
#   cp tests/qa-browser/rahasia.contoh.env ~/.pal-k3-qa.env
#   chmod 600 ~/.pal-k3-qa.env
#
# Berkas tujuan berada di luar repo dengan sengaja: repo ini publik, dan sandi
# produksi maupun token QR yang ter-commit akan terbit permanen di riwayat git.
#
# Format akun: PERAN=nip:sandi
QA_ADMIN=1001:ganti-dengan-sandi-admin
QA_INSPEKTUR=2001:ganti-dengan-sandi-inspektur
QA_PEMANTAU=3001:ganti-dengan-sandi-pemantau

# Token stiker untuk menguji alur pindaian. QA_QR_MATI dipakai membuktikan
# halaman "Stiker tidak dikenali" muncul, jadi isi dengan token yang sudah
# dicabut, bukan token yang masih tertempel di lapangan.
QA_QR_HIDUP=PAL-K3-ganti-dengan-token-aktif
QA_QR_MATI=PAL-K3-ganti-dengan-token-yang-sudah-dicabut
